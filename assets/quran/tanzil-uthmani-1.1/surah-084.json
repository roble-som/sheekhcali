  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "sha256": "820497cbb018f59a315476a04a271d10a5d4b0bca361716882b53e3acab56468"
    },
    {
      "number": 2,
      "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "sha256": "8355458e84437752ee84567d5713048e42289b6e83f65dc1da7fd4973d09308a"
    },
    {
      "number": 3,
      "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "sha256": "69afd00fbffee6ed5b95a1a7463d152372c7f4b92ffe0ee3533343bb2f9ad725"
    },
    {
      "number": 4,
      "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "sha256": "3fbceeb879ee88e2436f3d4db9c34a6781e2c0ba9f685f19499dd0f0fb97b44b"
    },
    {
      "number": 5,
      "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "sha256": "8355458e84437752ee84567d5713048e42289b6e83f65dc1da7fd4973d09308a"
    },
    {
      "number": 6,
      "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ",
      "sha256": "775eea74ffc2e8bf1e9010e52be00553e56f294d1b982c39ba24cd2feabede06"
    },
    {
      "number": 7,
      "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
      "sha256": "c4be5f885591686e8e94452386f225e7595e0db80a61b5ffb6b2c7b95a41df20"
    },
    {
      "number": 8,
      "text": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",
      "sha256": "6da7436497ac37aa9f97b3e199713519972f1e0affca6a9dd8c810ba86df85a1"
    },
    {
      "number": 9,
      "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا",
      "sha256": "1237238df167743bae763adee989262af871ee3cbc5ab586deb669f3a97d737c"
    },
    {
      "number": 10,
      "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "sha256": "aae3ad9e45a7e1bceed28d50a41b24dc0c1e16af2f8b6c8747acf3e393dcb329"
    },
    {
      "number": 11,
      "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا",
      "sha256": "f59c7d22fcd1b70d2c6529a691216fa2a5c4b515d7b51aac2cd22ca3573febef"
    },
    {
      "number": 12,
      "text": "وَيَصْلَىٰ سَعِيرًا",
      "sha256": "6862c10b2f1b1e481e87942b95e15f307bfd8ed7de354ddf0a31a97ee96777c8"
    },
    {
      "number": 13,
      "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
      "sha256": "b7cdc6b91b614b7dbb9f2907a48ee03a956195dec01065f91987c2d1c2234ece"
    },
    {
      "number": 14,
      "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
      "sha256": "2eafcbf57c5e461e68f8456b6e8af687bf72a49f9df70f262afe3a21f57a6a13"
    },
    {
      "number": 15,
      "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا",
      "sha256": "4733a4d7a7fe649eaabaaa35cb3d9b8514b2407a0fef757cf1f53440fbbc627d"
    },
    {
      "number": 16,
      "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
      "sha256": "0e2ec929f6bcf36df817035b91cc94cdc75d5e3059f0ba044f3d6e57b0ab5acf"
    },
    {
      "number": 17,
      "text": "وَٱلَّيْلِ وَمَا وَسَقَ",
      "sha256": "eb6d4a99b9715eef6a782f3834f50d5b127388438818fc7d752f6d14c3a1aa80"
    },
    {
      "number": 18,
      "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
      "sha256": "e51b0b5a7da908733b7d2cd534ffed55d399bdd1adcca4ff27127c322f30e9bd"
    },
    {
      "number": 19,
      "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",
      "sha256": "c3e1bd0dcf4035ec76125d301711f6c87b7d48969ee023c9a8382cdfb9734800"
    },
    {
      "number": 20,
      "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
      "sha256": "d5e49da44f9c79f7edbe47c37edd2ab6873731400957ff3e695770202334485f"
    },
    {
      "number": 21,
      "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ",
      "sha256": "9b83cdf270cb6703adf6d56fd7a6f53d9b4dd9b71c3b23bbafadf1cf43c59558"
    },
    {
      "number": 22,
      "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
      "sha256": "3192955db36ff60951db3834a5792889cf8074760d289f4cc06bfa6aa334aa11"
    },
    {
      "number": 23,
      "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "sha256": "449cefc3cd0adbaeae4ba9067cecb3a2ea989b7546697c795ab6b52c76659af5"
    },
    {
      "number": 24,
      "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
      "sha256": "42f61e08f9022ae7e065753834e9edefc9572a9f1ebd7635f0ddafbd3a29c63c"
    },
    {
      "number": 25,
      "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
      "sha256": "7554069fae277d8547b58fe722bdcea2a4967d63db3169a74c39dd3e46fad8d7"
    }
  ],
