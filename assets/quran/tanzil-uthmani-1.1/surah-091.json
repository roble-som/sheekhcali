  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا",
      "sha256": "0622e44eaa5fab4b20e7139d3109eee296da76fd9fd4c21b3ccf0b36bdb36db0"
    },
    {
      "number": 2,
      "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "sha256": "d8a4c9c825fe8056d828a97eea2616cb6b69248a56798754d778c9471f28e5d3"
    },
    {
      "number": 3,
      "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "sha256": "ab9e23473b78be8672207581fd5c98a164da4a01579cb0179444f139bb4da6e9"
    },
    {
      "number": 4,
      "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "sha256": "50f79fe387f6721f00daef7ff3db0cc1632ace54577dbf51fb9c3080bdc9b791"
    },
    {
      "number": 5,
      "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "sha256": "0f871da71024e756d4a79316460868a7271b478d4698af9749f56b72c4b0a99e"
    },
    {
      "number": 6,
      "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "sha256": "9b1e248692413a6d16d40d1f3661a9d46d5afce65e7181fee599a5075a71a2ba"
    },
    {
      "number": 7,
      "text": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
      "sha256": "1d9be72dbc280da305a2893f29ca8aa1ede4333f3a5e562200d2cde6d0964431"
    },
    {
      "number": 8,
      "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "sha256": "16306088fc3cfd6cdad6124e470bfef77bfffeb336fbf14030580acbbe5b95d3"
    },
    {
      "number": 9,
      "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "sha256": "759c24980882d563bd88f0d6131818a2f7708d08d85fdf76e87d495de7edfb49"
    },
    {
      "number": 10,
      "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "sha256": "6e800dee2772c4aebc653bd18301ddda26fd413208127c6e31aa3e1721e65045"
    },
    {
      "number": 11,
      "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "sha256": "8445d13e755cd2d3b14acbf612371ee15e465a969a709421f15f634afedd0150"
    },
    {
      "number": 12,
      "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "sha256": "9d3487e2735bfb63ba396c2549fa0ee550f9d391991edd39427b300a32e8b2df"
    },
    {
      "number": 13,
      "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا",
      "sha256": "030e0b275bad48d8dfd7f5d6096a45fd726ddd3c0b7ba493aef20a1c1784c630"
    },
    {
      "number": 14,
      "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "sha256": "1ea49d3f96812ab6be24a17248c33bda1070721a90a4c290009199b7a852ac22"
    },
    {
      "number": 15,
      "text": "وَلَا يَخَافُ عُقْبَٰهَا",
      "sha256": "9628b4f4c805d773003283b4dd77cdff801d54488a0bd4cad732514eed5e9327"
    }
