  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "sha256": "750e727e2dd467f8552ef923d13859a72294ab99ebc26b0861e9b7c5b27e4387"
    },
    {
      "number": 2,
      "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "sha256": "ed2572e14d0bf141489ad5c3ec72f8980db679a819d8e9fed28395d0ce7b60cc"
    },
    {
      "number": 3,
      "text": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "sha256": "8075176e47fc96afe58237959dcde3ecaa28f6617970d7fed6136aefd36115bb"
    },
    {
      "number": 4,
      "text": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
      "sha256": "0cdb06ecaa87495060539c22b2f521000333058ce389c4000fe651a4ee583401"
    },
    {
      "number": 5,
      "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ",
      "sha256": "78a41e6bca6113ab0718c442d67aa3bb2f9d810a7e23f31262d5838c45cfb00b"
    },
    {
      "number": 6,
      "text": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
      "sha256": "3a46624cff5de4c05e9e8ab534f3b633b9c8ffe656b02f59993eb41683984155"
    },
    {
      "number": 7,
      "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "sha256": "e14c9fdcab3c8ff791e3f2299a6057abb758eb0ecf597c416b1f2f2f3a702fc3"
    },
    {
      "number": 8,
      "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
      "sha256": "baec5aaae6df74b476ad401c5542df0ae0e98d2efeb33bb5ecc83b3cd0680e66"
    },
    {
      "number": 9,
      "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "sha256": "41979197b698f45ecae05743ce1ab2d62272bab835e760da23b63951f54b4674"
    },
    {
      "number": 10,
      "text": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
      "sha256": "0b76abf5c480d5a552681f5d5d5285433c1af600eeeb7f89bce7d1cbd0738dc1"
    },
    {
      "number": 11,
      "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
      "sha256": "2d6420a0a3bffe6e3f1ad77f4ac88534dbb051e085cd3d23f4fb0310a03414f6"
    },
    {
      "number": 12,
      "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
      "sha256": "2692b4ff4decebab126c4052889c6713c2f988bf9a189ced5c1649fa6468d87a"
    },
    {
      "number": 13,
      "text": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ",
      "sha256": "99f9f81ca70ae38015d5d96b0dae225ab60147a63121f352242b1c0118dba9e9"
    },
    {
      "number": 14,
      "text": "وَمَا هُوَ بِٱلْهَزْلِ",
      "sha256": "20f1d766ed61f492fa68d806e5aac985680b3cf028de2971e4be07cfa20d7c2d"
    },
    {
      "number": 15,
      "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًا",
      "sha256": "f8d521200789327d9b0ccc72036a8be8a1a93a66a049f96402fa693fa90d07d0"
    },
    {
      "number": 16,
      "text": "وَأَكِيدُ كَيْدًا",
      "sha256": "ab32713b1b7b467ca7f3c0ee9cd7924bfc50075c6deec31ee40714932630845d"
    },
    {
      "number": 17,
      "text": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
      "sha256": "2adf2e5a5f1de9490faf05dd2740cae053fc4db607ac968cf3a2aa78fd33954a"
    }
  ],
