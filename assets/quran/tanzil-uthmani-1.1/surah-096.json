  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "sha256": "7e049d6c4db1cf0d82f7eaced45ff68a0d3e4daae1329e35c6e5e65b0642a07f"
    },
    {
      "number": 2,
      "text": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ",
      "sha256": "83dfe337f34c9276efdcac919385551b4d7411ffb5e96cb136021cb92f87ae14"
    },
    {
      "number": 3,
      "text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "sha256": "b7fe29e91e8ceb66bf71e54a531da3b18d4fd6ec1c790c0007d8362a2c953836"
    },
    {
      "number": 4,
      "text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "sha256": "663e1e220481de7efa015852d7a4a16d0d163921e81f64947da973c4f7c1afd5"
    },
    {
      "number": 5,
      "text": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ",
      "sha256": "e756eb8113c901384a602975633d930b6629077c87e50de1b5d5f3f6c912c89c"
    },
    {
      "number": 6,
      "text": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ",
      "sha256": "a18a12c9c24d4d857c1b5745a30f389ba66a08b9c864af12776640f57587deb2"
    },
    {
      "number": 7,
      "text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "sha256": "62e22ca72f87e9aa4715e4de3d2696cc79cf2e701a4c805a13a71300bf6aa4fe"
    },
    {
      "number": 8,
      "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "sha256": "6f72769ebedfb4de0ee08b3c209ed81b352a295d933e38e7fc156440e8ee4b50"
    },
    {
      "number": 9,
      "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "sha256": "a1349bbce3332f90a5050b1309d33d5c08df8a6b22593e31a783056866262e41"
    },
    {
      "number": 10,
      "text": "عَبْدًا إِذَا صَلَّىٰٓ",
      "sha256": "1d203f20a63b196f805726d9a23b5cdbd260f57f43dd0bfe2d1f8d61eeb08558"
    },
    {
      "number": 11,
      "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "sha256": "bae659920cad21683e2ef3e715c40bfb2312043053d1ec4122c1622e108daf73"
    },
    {
      "number": 12,
      "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "sha256": "c80930c189c4b14ef1c33a2e0ce93674d8c36e3a751702740cf1d9e33eb8f71a"
    },
    {
      "number": 13,
      "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "sha256": "1667fb4add2677b0fbd31dc94cc61b3c2a435f6c802612416aea245429da15f2"
    },
    {
      "number": 14,
      "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "sha256": "0114f6b72cb44a6c23d7d62c8755ae81243508da7e39f0ed7c84ae8848b77733"
    },
    {
      "number": 15,
      "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "sha256": "ce94a67eb4dbd014fbae0483057008b2b6bdaeeee180275b23056df0136fa293"
    },
    {
      "number": 16,
      "text": "نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ",
      "sha256": "4abcac1c325dc6503b576ef01b9a82de59acfc75311a7f9a0f8e81faf150b4ea"
    },
    {
      "number": 17,
      "text": "فَلْيَدْعُ نَادِيَهُۥ",
      "sha256": "00bd87b5d8f32c49d5ee97c9bff120e04f7d5c33f9c02504d454a406d761096c"
    },
    {
      "number": 18,
      "text": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "sha256": "c0e40d3f96e093f9d87171df310802305da5a719c052d0be50a6cbfa3eab1f3a"
    },
    {
      "number": 19,
      "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب",
      "sha256": "e9cff651ad2d1b471c24afedf220c4e557f83e5be7d8890e4cf0b558b78d921b"
    }
  ],
