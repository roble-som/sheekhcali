  "surah": {
    "number": 78,
    "nameArabic": "النبإ",
    "nameTransliterated": "An-Naba",
    "nameEnglish": "The Announcement",
    "revelation": "Meccan",
    "ayahCount": 40
  },
  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ",
      "sha256": "50d129287626772de16c7e9d5c51aebc5a9c434e688641419757d68f54ebcbc5"
    },
    {
      "number": 2,
      "text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "sha256": "7dc905e6403da2a28abe74255d531fc4156c14574f187002c4f335fa6c5750ae"
    },
    {
      "number": 3,
      "text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "sha256": "90ee9341bf39d86d8b58d08933f89ea69f1b59311ed8072fab243f0bc60d1c7a"
    },
    {
      "number": 4,
      "text": "كَلَّا سَيَعْلَمُونَ",
      "sha256": "b07c850ced39ecb50909de50bddddbffcb2db19da4655d2fd8f1e0b935ae67e3"
    },
    {
      "number": 5,
      "text": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "sha256": "9eddd2764a008b1684be37ec7ae8e951b9388fe2c58dce38d0dd9ee3d33ea009"
    },
    {
      "number": 6,
      "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا",
      "sha256": "26bcbc53f260b9e0055069c706d7cae394c8f80b141e12e69d1ec4d56121d422"
    },
    {
      "number": 7,
      "text": "وَٱلْجِبَالَ أَوْتَادًا",
      "sha256": "7b1bbe2e3c5ac164e48a84774c077a250ab04e865fe1533285733ea878c02726"
    },
    {
      "number": 8,
      "text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًا",
      "sha256": "c1708ccb891738fff766679492954edc8ecd37aa4601eb575a32e33e485b7f5f"
    },
    {
      "number": 9,
      "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
      "sha256": "d71d83fd093d45634a3c33022d8581d6bdf8a75582e4a5a91c5b178c4f79f88b"
    },
    {
      "number": 10,
      "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
      "sha256": "64b515679c57cc19999bfd005fb0147309aca3d43a89090e3d5800039bf7eb35"
    },
    {
      "number": 11,
      "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
      "sha256": "cdf493c7251028cb18e2ce2a7e4254b8f0e8bfaa0e3cc3462b0527432bfa162b"
    },
    {
      "number": 12,
      "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "sha256": "c96011b7300878bf6efdd08b90a3507528ca007cfe9552f5c2781ce251faec2a"
    },
    {
      "number": 13,
      "text": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
      "sha256": "1ebc4f3e2eb9a6a7b12a519237c569bc7a19765ad869c30016b77b312e1aedb1"
    },
    {
      "number": 14,
      "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
      "sha256": "f97f2b8a78798454f8d302fcabdcefd7e3409e1111b542e8f1beba6f1dce549d"
    },
    {
      "number": 15,
      "text": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
      "sha256": "96bd59ecee6070fe74214842ad94a4033982492a21ceec924305200aa96cf034"
    },
    {
      "number": 16,
      "text": "وَجَنَّٰتٍ أَلْفَافًا",
      "sha256": "d4847df10173c60eaa5e599ed1d66649b45ce6cd04bfd2c5fb774187b3e54fa7"
    },
    {
      "number": 17,
      "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا",
      "sha256": "7963f7a6d2654cfa3c8483150828771c4317ef86c405e07603ca6ff6aa0ad5a6"
    },
    {
      "number": 18,
      "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
      "sha256": "f820b84b1ff2c186a1883b8fe67c79fb8fec35d0a9ff27cced0026e4ac591184"
    },
    {
      "number": 19,
      "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
      "sha256": "ba177e36f8ee88de941aeada7337245aa5263e6481a70e9b94fc74a3f8ca3f43"
    },
    {
      "number": 20,
      "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "sha256": "1562a8d5dd276f59002b883651a7387ef8c3d08348121502384d8dc003786e49"
    },
    {
      "number": 21,
      "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
      "sha256": "f05a17e54dca9e5230f01e54283983ce1ce0947d5d76528c04dd1e899740d1f9"
    },
    {
      "number": 22,
      "text": "لِّلطَّٰغِينَ مَـَٔابًا",
      "sha256": "7eae25189569c95f32177903cc03115af46942d4af74090e80d8edb0a3122417"
    },
    {
      "number": 23,
      "text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًا",
      "sha256": "7a38e37f0722106deba63b0d394feda6e3668f0f2a7b4e1335a9229637372eb1"
    },
    {
      "number": 24,
      "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
      "sha256": "258e1032c222eb6547b8d5abaf344bf7c2ab326cb0aafad3b89c94327089b597"
    },
    {
      "number": 25,
      "text": "إِلَّا حَمِيمًا وَغَسَّاقًا",
      "sha256": "3d751c974c8d9f4af4fd602db258caa58f22efdb1906d2d8f5c50bfef0820842"
    },
    {
      "number": 26,
      "text": "جَزَآءً وِفَاقًا",
      "sha256": "f4cf6589b0266bcaaeb2f5607f1b9b4c0dc8ea75b2e907334cf966e71342cd0c"
    },
    {
      "number": 27,
      "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
      "sha256": "925a00c8fa418720796acadd135e662b968ef82acacc9cd37d2e19920e696bcf"
    },
    {
      "number": 28,
      "text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًا",
      "sha256": "36c1403c4fbdf488f69e9f6edd9a48e7682e2f7dd95bb176db8683af8473f73b"
    },
    {
      "number": 29,
      "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا",
      "sha256": "2cddb10ca10b2cd8ecad81981ffef22412c4498f027f8afd9a93dafe1522d58c"
    },
    {
      "number": 30,
      "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "sha256": "3a879469882a59a899d59b0ecc808549e288eb572096bb819220c1d924d36f2c"
    },
    {
      "number": 31,
      "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "sha256": "8ff4658ea733ef98353912463c0495b8dbe924c4d3472d0fb69df273deac46f0"
    },
    {
      "number": 32,
      "text": "حَدَآئِقَ وَأَعْنَٰبًا",
      "sha256": "009622a1d3ac69c113beb745a04db5326c9c4079eba55cd4f23e1113e859ee57"
    },
    {
      "number": 33,
      "text": "وَكَوَاعِبَ أَتْرَابًا",
      "sha256": "56c1971e774b472f2b631e02a79500830e98735e2467a28d3ad314686f797d42"
    },
    {
      "number": 34,
      "text": "وَكَأْسًا دِهَاقًا",
      "sha256": "b79bfc6f335f5c530cdee36915f14faebec6be13066a9038fbfb9a2baf344831"
    },
    {
      "number": 35,
      "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
      "sha256": "40990aa91651448be6673f57d8d6f066e0ea2bb71f04cda81877c22e8aef3fa2"
    },
    {
      "number": 36,
      "text": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
      "sha256": "98282dc00bfbeab65a5859d66171f1426ad53ea7bda4cba80e3ba2e12a37c33c"
    },
    {
      "number": 37,
      "text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
      "sha256": "d3e9e9fab7d82628cf3ba55b297de00ea5c724441f4fbd9c43882cd8dc276e9c"
    },
    {
      "number": 38,
      "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا",
      "sha256": "8c4e9b4134ecb11174bc25b0384fc1a0b77c206f56a0a8850bf41973d4dc5fec"
    },
    {
      "number": 39,
      "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
      "sha256": "12e7099730c3d1f01ebb525b215c098f217ecaeec6ceeadda5a034a05ecbb473"
    },
    {
      "number": 40,
      "text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
      "sha256": "740f592170ee795e5c4aa790ac3e4aaac09624e3ddb1aa7c8590676442909266"
    }
  ],
