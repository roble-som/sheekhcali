  "surah": {
    "number": 75,
    "nameArabic": "القيامة",
    "nameTransliterated": "Al-Qiyaama",
    "nameEnglish": "The Resurrection",
    "revelation": "Meccan",
    "ayahCount": 40
  },
  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
      "sha256": "2ecd99b90724bee07696227e9f2ffce5a22bc6317b48cc9079340e1a594bc299"
    },
    {
      "number": 2,
      "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "sha256": "67f6d3f9adb6010992279ff2299bf7a7bf8cbb065e80ae227ad9584d373dd968"
    },
    {
      "number": 3,
      "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "sha256": "ecb5fb5340c2bdd6c3f3af5f69dfe3110a3fc47047db7764a4cf018d3b4e7ca2"
    },
    {
      "number": 4,
      "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "sha256": "bfa40caeada88cb235923bee27864f52043d4a6a32788e764dd2f623c619b814"
    },
    {
      "number": 5,
      "text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "sha256": "70db1fc67b8d736d178672a0c808c5c2917a23a48cfb904406f0e84c2a859243"
    },
    {
      "number": 6,
      "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
      "sha256": "24fcb38d190ba11f5075fa7016721473af6f0e56a220d479fbeaf309726b4d89"
    },
    {
      "number": 7,
      "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "sha256": "11ff1d39577fb30631c41a07ae1180e6f95380b58773251d4c8c19f51efe1974"
    },
    {
      "number": 8,
      "text": "وَخَسَفَ ٱلْقَمَرُ",
      "sha256": "283323674eff78b87aa5e54aa3d393299352d1a3db5f763f088a69dffa80aaf3"
    },
    {
      "number": 9,
      "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "sha256": "94e749a9251176b2237d25bd5ae235c61dd740eeb6ca55f658f02a3ff1c5c87e"
    },
    {
      "number": 10,
      "text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "sha256": "17cd1aec8f6bb508347f94ea7baccc0f7687df6a14ea49adcfeb4c21f9d48636"
    },
    {
      "number": 11,
      "text": "كَلَّا لَا وَزَرَ",
      "sha256": "dbd3c087035a8a32fa169e4f62291c7cc3826098499d804473beec21534bf2b7"
    },
    {
      "number": 12,
      "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "sha256": "01b8c60da6028a1d3fc87f471edd23a198f125b282169020006b80033d833f98"
    },
    {
      "number": 13,
      "text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "sha256": "11771c72d0f9c31c7c2adbb8b220e6f2d8a025d6f182dd9e8000d13981f27f6a"
    },
    {
      "number": 14,
      "text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
      "sha256": "2afea4995044ca7114d43a6cdc5e99840d0167d99e1398681e211a56dc27bdf4"
    },
    {
      "number": 15,
      "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "sha256": "2c10340fadb3cb23939c72717ddd1436c536e845eacd74976f915822b553b3fe"
    },
    {
      "number": 16,
      "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "sha256": "e84aa63b35afa2a613f29788c73ccdfb51c166cf2d25c3b49c54d3b4e8c24a41"
    },
    {
      "number": 17,
      "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "sha256": "d82fd9744304f472f0753e22a39cbaedc1ab9fbc74bc8f1466607e2ce2043cac"
    },
    {
      "number": 18,
      "text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "sha256": "ed5d522e06c41e7fa9fbb1111dc7f9759490735914663e4fcdcb0ece139b5490"
    },
    {
      "number": 19,
      "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "sha256": "737f11422b3d0a1e64d4abb5f1ef8ee8b4f322ed52e95c1ce087e753e14f3ca8"
    },
    {
      "number": 20,
      "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "sha256": "19351f05b97fca70df9d8bbde49e5731c1b75cac175e8dee2799e21828d3c91b"
    },
    {
      "number": 21,
      "text": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ",
      "sha256": "ed7a6127c0a41ec119913298399428a4ec55bdb4d8e9d95b95c72b643eaeaa1a"
    },
    {
      "number": 22,
      "text": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",
      "sha256": "5b97d4d8ec49be64890e68bc6d05dc48bb0493382c79279edf6f7f77a1413652"
    },
    {
      "number": 23,
      "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌ",
      "sha256": "c4c3fbe1231624430a50f15056b5a14b8710b8e9cb88ee514c7e48437c8eed8d"
    },
    {
      "number": 24,
      "text": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ",
      "sha256": "0ebf845e4e634a434704c4144ac406b873ef8123b9e30e1f92e471f04c6db2dc"
    },
    {
      "number": 25,
      "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",
      "sha256": "df671377c4690db6d2d4ae00c343e30f73fec78e7cc50b082359d4243be55947"
    },
    {
      "number": 26,
      "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "sha256": "0d9341b15c40d0a7e8a32c8f7c679f558d57dff7698ba0c52002f0342e2863ed"
    },
    {
      "number": 27,
      "text": "وَقِيلَ مَنْ رَاقٍ",
      "sha256": "c995cea65e929c089a008412f61b535c6fd5acd4346bad2f810ab4ba2fc68256"
    },
    {
      "number": 28,
      "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "sha256": "17831952aa40e25956440d56ab727e61e531512f26b5936db26aaa343406a9f5"
    },
    {
      "number": 29,
      "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "sha256": "40b54aaa90d9d1e9cfaac2116204702a429f97d40b692c7051055193a6ccd4df"
    },
    {
      "number": 30,
      "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "sha256": "127c453536a3cd8b4084d605c5364871b502ca0428f58225b113c7afd48cf27a"
    },
    {
      "number": 31,
      "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "sha256": "2ccb34262212ec765ae4547088db315d47a9abb724ee47eabc7c40b31bce310b"
    },
    {
      "number": 32,
      "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "sha256": "d0aa742160bf3f33934e54c1a8fbb455a97381a1027b8f8a57803d581519f41e"
    },
    {
      "number": 33,
      "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
      "sha256": "e0bee690d150c99472b361a969f393684458582aaaa100e1c617f3c5d9ace06e"
    },
    {
      "number": 34,
      "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
      "sha256": "edccaf25c5afc54ffb66774d208b4a2d6dab104c80fb9a85ac7184eec7444db2"
    },
    {
      "number": 35,
      "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
      "sha256": "171e64071787efb5d1612c4b74754db401583f5ca2641c70541045399beba8db"
    },
    {
      "number": 36,
      "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى",
      "sha256": "2323ffb152ba7526134c10682dad11c3152827a4454c0ede8865f2e7235b29d8"
    },
    {
      "number": 37,
      "text": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
      "sha256": "1234af9a1a8aa3932c4a14cde99b56ab227b695c436dd3acfceadda15e287c6e"
    },
    {
      "number": 38,
      "text": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",
      "sha256": "55745cd7843ef1c42f4adb08fff494210b5d520a6084691768116d4c2fe668a8"
    },
    {
      "number": 39,
      "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "sha256": "8be105adfe7501641f6782523e563c0be0c3cbef6c43b4a2539d5478150e5abe"
    },
    {
      "number": 40,
      "text": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ",
      "sha256": "5b8bec1ebcf6e43ac41e3b87a80c2f52606533883c30627c364a151e00cb947a"
    }
  ],
