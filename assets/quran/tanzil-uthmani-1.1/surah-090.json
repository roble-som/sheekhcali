  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ",
      "sha256": "f2235b60dfb8080309b80eeb3d577f61e41ad6fda9b49998edb92a4b6f9fb341"
    },
    {
      "number": 2,
      "text": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ",
      "sha256": "1d8981744188f58870f3ad0ef69ddde144ff9e4146684acdb537eaf3306c4afc"
    },
    {
      "number": 3,
      "text": "وَوَالِدٍ وَمَا وَلَدَ",
      "sha256": "282d8306704ceed68e3c50f86374908ef96f882a5625ba1851a72be900ae417c"
    },
    {
      "number": 4,
      "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ",
      "sha256": "f3b95f31b9ad90d81af1751ca2f6fd7c66d2acd93a6e34a7baa24eb47a606753"
    },
    {
      "number": 5,
      "text": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
      "sha256": "57310a67b72d8abd485b93b64d511659efeb8a52d8d260a47d4349fabfa2369a"
    },
    {
      "number": 6,
      "text": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
      "sha256": "140019d63e6dc8b2b73c38428d241a0f533485eb18405d40b71f73652da7556a"
    },
    {
      "number": 7,
      "text": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
      "sha256": "c48875e866ae98d826e825cc147df8319562f9d6aa331a35fbad54270af78386"
    },
    {
      "number": 8,
      "text": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
      "sha256": "345eb244c0ac48e53595f8575243677504bc3d82388b569d171ec7a8b68d98dd"
    },
    {
      "number": 9,
      "text": "وَلِسَانًا وَشَفَتَيْنِ",
      "sha256": "a350695da0456b00d537eaa1d89e7a0e5199c68d2c9daa67f348657365d5a7a0"
    },
    {
      "number": 10,
      "text": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ",
      "sha256": "f952d45ee13bc7704bf94bf143d96e0381e0315468291c1f936959b1698335ac"
    },
    {
      "number": 11,
      "text": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
      "sha256": "b477665761218de747c4112c4cbe342ef53fa7752f93c6497d1eaa7732f40701"
    },
    {
      "number": 12,
      "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
      "sha256": "c2d30948edfd38c2c8ff985e8a7eb36a74050d87c7d8e4d7de7d96ec53e9445e"
    },
    {
      "number": 13,
      "text": "فَكُّ رَقَبَةٍ",
      "sha256": "aaa08ef1f34ff7b2c90207bd22e0ba26bb0a1f1cce5a87252f3ba4fb4cb4c3bf"
    },
    {
      "number": 14,
      "text": "أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
      "sha256": "0c2585db9d026e33f0b2e1cc9c0202f3abf8d5bef3358cb95e2ea6bed6cbdbef"
    },
    {
      "number": 15,
      "text": "يَتِيمًا ذَا مَقْرَبَةٍ",
      "sha256": "72477a0991bf2424b62df9bb9bd434a635f8e3bf576cfc2780b6744d85cc195d"
    },
    {
      "number": 16,
      "text": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
      "sha256": "d3f96b02ee4be01343ec2e9e84f62ead542de0cfbf4dac5e6d9545078de92259"
    },
    {
      "number": 17,
      "text": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
      "sha256": "076ecad1d16b4374ff362e671a90c6d60d062653b6a272fadadb532e94b3f873"
    },
    {
      "number": 18,
      "text": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
      "sha256": "55bef92aa7a6d74673b485516d5e2ea6c908cf97d4868de9b459ec2055da7152"
    },
    {
      "number": 19,
      "text": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
      "sha256": "d44ce6f42575bc6c60ac034fe9e94d2e1f0089ae98aa722dc836134baf6469e2"
    },
    {
      "number": 20,
      "text": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
      "sha256": "7eefe3a7938c1412e33c42079d68d128deb358dad5f2f704da48ca9a6d5164db"
    }
  ],
