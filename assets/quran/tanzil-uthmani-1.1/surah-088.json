  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
      "sha256": "4f117ebd14d2a20438a6ed1d250b71567f6cd5ce1dc2f0c1e3c06704d68ed5ab"
    },
    {
      "number": 2,
      "text": "وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ",
      "sha256": "78f03864f5327698b80aca5330c90606602dcd6c323d52032f134452e2bcc99c"
    },
    {
      "number": 3,
      "text": "عَامِلَةٌ نَّاصِبَةٌ",
      "sha256": "2fae930f29fd1721db082aeca790cbdfaacda180d9044c985f12932b46e54b2f"
    },
    {
      "number": 4,
      "text": "تَصْلَىٰ نَارًا حَامِيَةً",
      "sha256": "3a3a8be7f5176a803edbe96f77b84585e8818b88c4b6e94646892298c61dcd25"
    },
    {
      "number": 5,
      "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "sha256": "1a90fda1dcf652836941e7ac4c06d97e9c7fcaa9ccec459e3fe1afd1d5abf2db"
    },
    {
      "number": 6,
      "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "sha256": "f1625bce860e95e0590384b2904e476ce83b043877da9a31ca23d72ce2d6e333"
    },
    {
      "number": 7,
      "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "sha256": "260cbfce515ededbb802baf63b8f1b6ce89a8b974e179ca4a5f2cae2f6fb3cf4"
    },
    {
      "number": 8,
      "text": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "sha256": "73faad2d5b54bd4cd3e1ebcccf02fc7bd4cb354ceb942862ce13495e4428ecab"
    },
    {
      "number": 9,
      "text": "لِّسَعْيِهَا رَاضِيَةٌ",
      "sha256": "ffaf6287f016df23207e77f460d10b6e2f91f0ea1c021ffc274921e35474a21c"
    },
    {
      "number": 10,
      "text": "فِى جَنَّةٍ عَالِيَةٍ",
      "sha256": "544509e5cf49a31dd0bff7ed7013d9daf14ce2bd49f7be24a77f92a4f8456675"
    },
    {
      "number": 11,
      "text": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةً",
      "sha256": "f1860b590f72dc8b45526c05e042ac1687039f29dbccf06d83f1841053e9d557"
    },
    {
      "number": 12,
      "text": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "sha256": "adf98a18e1f0af086a864f3603300754a5aca634da8125b89e6fca51cf9d183f"
    },
    {
      "number": 13,
      "text": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "sha256": "c5250e93abecbe0b7cab10ac2880e2cf81d9e22cdaacbcd66ed02aca6d24d06a"
    },
    {
      "number": 14,
      "text": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "sha256": "41291fcff87c4eb29a623a5593e32b5ea554e577397bebc710ec4198b5a1cd4e"
    },
    {
      "number": 15,
      "text": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "sha256": "be77894be90ee1fb60b24b23c90edb16d53400e8fef5d47083581b3e4b43a87b"
    },
    {
      "number": 16,
      "text": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "sha256": "ccbfd3a5ff35e51e0b56b0c5a788691b777eb149c6bec803cb852abd48c9562a"
    },
    {
      "number": 17,
      "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "sha256": "4ff535769f0d297a9ec792709d73a591c05277f8de9899961677f06f7d1ac4f4"
    },
    {
      "number": 18,
      "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "sha256": "a965098597b0b3ea76500b1a4740b8a5ab5b87ff9aca21a24377b95f7958964d"
    },
    {
      "number": 19,
      "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "sha256": "6c347f5463a7e4c7ea0fd013228250d16c37fd730a7befe88e13e7083f0fa82f"
    },
    {
      "number": 20,
      "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "sha256": "0b63d5857bea4775e8c7e833372147c4e937d72f5aa29cbe6e797c8b023038ae"
    },
    {
      "number": 21,
      "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "sha256": "374157a123b50876eaed55a2cb1dbbc9289cccda109c2b39e5e9b1f9f1c36f1e"
    },
    {
      "number": 22,
      "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "sha256": "35508e753a7e467dbfbefff2223ce40dee5f122142e8b9d0bbf11b2e5e4ae88f"
    },
    {
      "number": 23,
      "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "sha256": "fcc04e739d1628727b4b596d3318a6ed1988701ef1e07cc5b24194670d3eed6c"
    },
    {
      "number": 24,
      "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "sha256": "45bb253174ec390913b577ecc32d76d72f41020a628220594fcd0713ce18bfb2"
    },
    {
      "number": 25,
      "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "sha256": "69390234b0c9658826ba6e050d8937a5bfd08c4dc96c2014fb3f4f254927c84b"
    },
    {
      "number": 26,
      "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "sha256": "cfca090be2715b30cc6e1a179d435c3476144c69e1d06e573109a32b8588a19c"
    }
  ],
