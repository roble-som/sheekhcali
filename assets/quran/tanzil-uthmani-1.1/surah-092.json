  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "sha256": "2c524083bfce708af3c88223c2b6f81b8556a54b9420ed56a1d68f51e12de91d"
    },
    {
      "number": 2,
      "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "sha256": "da3886c507434eec91e73524db610bb3d64c51398ad596a2b273f6737777af98"
    },
    {
      "number": 3,
      "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "sha256": "f83624642fac786b2ae5b44a94f570165dd3f6948ab580910f65e2e685656458"
    },
    {
      "number": 4,
      "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "sha256": "2285b238b5d82dc2660a5a833bc28af188762c46aa67eb2ab1ee6c5abc66d6a4"
    },
    {
      "number": 5,
      "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "sha256": "b96ce9e113f5709c323ad57d4f51c1feb19e554e3516c0d16580330241d40075"
    },
    {
      "number": 6,
      "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "sha256": "9f01cdf90db8f1de3c5c8b20a596991307192c81fdd881bada6a4b04984cf2e1"
    },
    {
      "number": 7,
      "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "sha256": "358fc5e2f353b01d7dae6fb36f79406e84aed697d089e85001bf162dbe12f92b"
    },
    {
      "number": 8,
      "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "sha256": "ad8198af45715d23d9a04b6cef76935cb7b92f723f35403b6ff6767dd97ce595"
    },
    {
      "number": 9,
      "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "sha256": "7a9f0c1154d3dc33f3c140c68a7da55c15987e1031441aacc801c5de774e18a5"
    },
    {
      "number": 10,
      "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "sha256": "aae7d2e10572b8a653a084ebca688dd3d9946726f93aeba82c01f383aa9494bc"
    },
    {
      "number": 11,
      "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "sha256": "70d5c0618318e5e2ece993e35bc6f8077c2256fd4b9dec623a877b2db01260a3"
    },
    {
      "number": 12,
      "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "sha256": "afa76b062d6525207cff981c89272195d08bf9bfdafc25e4baab62866473a245"
    },
    {
      "number": 13,
      "text": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "sha256": "b96733df379d0baa615ee966ca6882660ed7b09012eeecddad259ef6bb1372c4"
    },
    {
      "number": 14,
      "text": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "sha256": "fba462435e5eeed27514029ac8b33a3762a96b71fe8bfa67dd941be704bb8437"
    },
    {
      "number": 15,
      "text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "sha256": "c1e586d7ba1dafb911e84b88c30b4e7cc3591d7268b13dac233f22010482de41"
    },
    {
      "number": 16,
      "text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "sha256": "6f37e5b7423432f25bffe2b3c57e1a3fc9441c793e37d5e1f6d78552c0f5b465"
    },
    {
      "number": 17,
      "text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "sha256": "f872208b0e85560e8f6ddde5b9a6efc2028a44e57b42b185b43304b732bd53a6"
    },
    {
      "number": 18,
      "text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "sha256": "e90b0690e784b487530d11f2900dd417f00355a77d4148d794f7d6a9a9f86d30"
    },
    {
      "number": 19,
      "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
      "sha256": "ca7cdd7d75e41c4d2245d2648840a3a9b62c9431bf67198d927fd6e1e88e209c"
    },
    {
      "number": 20,
      "text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "sha256": "6b0d7efb3310f6d4fe185bbffce257f2f682bee3664162b885415138064334d4"
    },
    {
      "number": 21,
      "text": "وَلَسَوْفَ يَرْضَىٰ",
      "sha256": "49cb76fd07e5ac8257b4952b6362fc58c59c22711cd84de5b37a3f9ee1b633bf"
    }
  ],
