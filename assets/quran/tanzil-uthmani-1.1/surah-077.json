  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًا",
      "sha256": "386be508212b1daca6570b5a0d8ea900dab61de9fbba44930f173c120e959dc5"
    },
    {
      "number": 2,
      "text": "فَٱلْعَٰصِفَٰتِ عَصْفًا",
      "sha256": "ab05f13cb574b456bc81b3f0cdb8f13a2ddc7d9c7df43c789f4e4722ffd6eeae"
    },
    {
      "number": 3,
      "text": "وَٱلنَّٰشِرَٰتِ نَشْرًا",
      "sha256": "0e73c10bcb4cdf6c7af07287608916cb47d31b756f992ae7553cb1ed8aaa79aa"
    },
    {
      "number": 4,
      "text": "فَٱلْفَٰرِقَٰتِ فَرْقًا",
      "sha256": "327ad80393fc7d1835b7275331aa21838c5a0e1d8e4c29f5835334a9297b9085"
    },
    {
      "number": 5,
      "text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا",
      "sha256": "ab0a7b646e507b274955b121206aa3799e48735c4ea4b2b9902a987e4bf9c92d"
    },
    {
      "number": 6,
      "text": "عُذْرًا أَوْ نُذْرًا",
      "sha256": "d3947be0ccef617eb3121aeb9c785a930b2c15a9ce300d91849e06d20f286db7"
    },
    {
      "number": 7,
      "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
      "sha256": "2e3cc4ab7ec5707551df111fd1f2672a4280ce7746c954c05d254223ce01b032"
    },
    {
      "number": 8,
      "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "sha256": "03c6abcd826b46a1c7c0c3e17a88f20d044b93bc8ffa849ec95ce6c224b1388c"
    },
    {
      "number": 9,
      "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "sha256": "2fa01a891e16c0a892f12f62f80c2bf11e06d53c55b1b8ab6879ff7e5351a0eb"
    },
    {
      "number": 10,
      "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "sha256": "14ce6629b8237792ec87fc363b6a954760191ea51cd96ae48bb2fae0e0226e38"
    },
    {
      "number": 11,
      "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "sha256": "d7fab9a1b4510e08f53de4438f280f17d92c5874617f468086ae55be3cb823cf"
    },
    {
      "number": 12,
      "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
      "sha256": "2fabd3d446b2fa1368bf24645d2e4cd0205406d99ed9da5dd5284d330d63fb0f"
    },
    {
      "number": 13,
      "text": "لِيَوْمِ ٱلْفَصْلِ",
      "sha256": "f6e5474701e5d41fc52a75cde823c84b627e3f4d7c0b8634cb7de35104abfeca"
    },
    {
      "number": 14,
      "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
      "sha256": "7a90b11cde9c021609af6bb777b13e7284c4a3ffe8875006f3346b848203669c"
    },
    {
      "number": 15,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 16,
      "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
      "sha256": "4e5e4e63ccc4a68d30fff965815377bb2226a31a5c591817df44d9806dcf6bff"
    },
    {
      "number": 17,
      "text": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
      "sha256": "4caee0fd4e9b527f04c6c7bd3c6750b22aa32bba2660cff89766ff79685414ad"
    },
    {
      "number": 18,
      "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "sha256": "40aab55b7c793665d50e4450278b8ad1cf59921f36eb8af96fec9fd83baecd00"
    },
    {
      "number": 19,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 20,
      "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
      "sha256": "f5de7d190033dfe838a1e93d684ba5d662164827c1672b3438b64e3aedb0e996"
    },
    {
      "number": 21,
      "text": "فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ",
      "sha256": "57d1a75c8f4fa919156f42d51f33fe72f3dd0ef0c9da347b2fc672ee760b3f61"
    },
    {
      "number": 22,
      "text": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
      "sha256": "245230a033922b93595759792c3c1d189898ca5311e9323d48e5db39c4245730"
    },
    {
      "number": 23,
      "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ",
      "sha256": "a9154709841fbf1a119e7aa92a9b36849647e1cf270cbdadb844c55327081755"
    },
    {
      "number": 24,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 25,
      "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "sha256": "b335d053e43406d2f200d3e2763b79b73bf5214ee72fd991bf7fb353e23f7268"
    },
    {
      "number": 26,
      "text": "أَحْيَآءً وَأَمْوَٰتًا",
      "sha256": "fab1368e8e94b302905baca2319cab7634e0bb77b4834742097dc6bf59c5f74e"
    },
    {
      "number": 27,
      "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا",
      "sha256": "8484dc875306ff0d178bfbdd3a77c65b21643144077fcf6843506638fdb77578"
    },
    {
      "number": 28,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 29,
      "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "sha256": "64bb9791313e2f23f770aa926947b121a2d6a168a34036d76d1cacc7adf4b09c"
    },
    {
      "number": 30,
      "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ",
      "sha256": "aa1f19f7c5deb914e540f67d3475f7bb50361390d7cd89fea3ac71caab8cca19"
    },
    {
      "number": 31,
      "text": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "sha256": "d638fdf528ab9db3c72bb207c3f0bcffa2f42b35dd1a89613ca828b80a457890"
    },
    {
      "number": 32,
      "text": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
      "sha256": "9ea613449db958733c138f4b2b651fc1376e340f9dcaa938c7b7fe714864ccb8"
    },
    {
      "number": 33,
      "text": "كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ",
      "sha256": "e0e45cf2292dc32494cecc52e5bbc7310593066942aa70f1f2b05e284727b774"
    },
    {
      "number": 34,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 35,
      "text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ",
      "sha256": "8c23decf1abca81e2776222c5a49960af9cf7105058e8292d70c8a721f60c9ab"
    },
    {
      "number": 36,
      "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "sha256": "4c322e721d90c21236c25d1f446f3e5fc8344cb427a90536a590bb795d5076fc"
    },
    {
      "number": 37,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 38,
      "text": "هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ",
      "sha256": "65b06673a13bb4681a12a35ff567e88ede5727e6b85f40a4a964bdf67722eb1a"
    },
    {
      "number": 39,
      "text": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
      "sha256": "ab3dd206f02adb446540216e1a4d6e8004661823c2bfd37185ed599f16e257df"
    },
    {
      "number": 40,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 41,
      "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ",
      "sha256": "f726952c4bc56db05625d9b6b0d6c8007bfbd3877dee1502e452a57b2e059c8a"
    },
    {
      "number": 42,
      "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "sha256": "2f6cd6fac2b112ccaf5a36044136c4b655b2bcd26054d8dcf112c2f26e286f84"
    },
    {
      "number": 43,
      "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "sha256": "18dcc97d83ebb7f5c40222187dab3c04f3358c67389ee0f675487afd80d70963"
    },
    {
      "number": 44,
      "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "sha256": "e6f5440c67afbbe96f33dc538bdc479d9ae65900fca491daf9f5936a92e2ac87"
    },
    {
      "number": 45,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 46,
      "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
      "sha256": "f59371057f488b5af5d006b70a25cb8694277431a3d47cb526daa3e88031fa86"
    },
    {
      "number": 47,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 48,
      "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
      "sha256": "ec000685a597487c735fcf3b6261e4a213c90416a6ef7fdb2653b701dc9b8880"
    },
    {
      "number": 49,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "sha256": "147f35716f7f845739690349bfcadaa92139da9a4d91775f2e50a17d23aa7e61"
    },
    {
      "number": 50,
      "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
      "sha256": "e0bd2f6d33afbb4e78e7e7534d51ed838dd21ac8f4aa54e51ee5b07841edb660"
    }
