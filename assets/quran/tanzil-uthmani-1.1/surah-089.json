  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ",
      "sha256": "95c5c3e7c65dfcb6194840e3cf1e9fe19c4e69d46d04db36c74f995e2bdb4ec4"
    },
    {
      "number": 2,
      "text": "وَلَيَالٍ عَشْرٍ",
      "sha256": "cd93479cbb4b38a7caf2b4ceeed3909509072d9ab8e4497d0ac045981ec7b25a"
    },
    {
      "number": 3,
      "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
      "sha256": "2e416704b56f5d2ed81334d1ae7220efa9ec039a6b46fa95539eeef1641bacd6"
    },
    {
      "number": 4,
      "text": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "sha256": "b57e57a97b2b336927d1e891d0699218ee23923d668044f9f13ea8933f94446d"
    },
    {
      "number": 5,
      "text": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
      "sha256": "34eb70d06d5493ea2ba0a6dc6e1465549d930c3f659a37220aa57fcb6814b61c"
    },
    {
      "number": 6,
      "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "sha256": "a6f9fbaff3a0e2c8f63374c6a3730a1b7bb36a84050f97a30db6f8f5a57836a0"
    },
    {
      "number": 7,
      "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "sha256": "ebb0d98c303b1e3d8ade8ebbe8bf3fa96875205be1a7262f81984b04b9b229c4"
    },
    {
      "number": 8,
      "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ",
      "sha256": "7091c05e3093d2caa82945fb0f9bf248bbfd547d765f3077757770846cb44331"
    },
    {
      "number": 9,
      "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "sha256": "5f925bddc555dd7014e98dfaf7890b939da485f3e190d3731419d12eaff74313"
    },
    {
      "number": 10,
      "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "sha256": "9d0bbbc514f9129759439a2064689f4529878352aebc81a7503fd649da3f712e"
    },
    {
      "number": 11,
      "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ",
      "sha256": "6eaf30a434c4c772db94053aca0f5e516dce352684c59cf9ef393a85d6d5e12b"
    },
    {
      "number": 12,
      "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "sha256": "12d238aa19a329219bcbe387a8fedf42e397af25e48a53e618213c20c140d649"
    },
    {
      "number": 13,
      "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "sha256": "99f71b7e91747fa352e8595bad4d1933465356f71025114c1c32fce45231ef26"
    },
    {
      "number": 14,
      "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "sha256": "1661a83574022f90deaa638ed8a9a1e41dd14dfc7d7f337b9e6d0b0ad2d4c595"
    },
    {
      "number": 15,
      "text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "sha256": "3ce21ce9e887839f400bad329b1dcf9763d2bff97ceef35c6f764675e9bf45ac"
    },
    {
      "number": 16,
      "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ",
      "sha256": "faadc8cf107dbbc4fba9ba0bd2657fdf491dda05f33cecb733fba731dfbce80e"
    },
    {
      "number": 17,
      "text": "كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
      "sha256": "9ed7451e11d5bdde16d17452a9eec3aa8d97ef643493b0780e78fdfec384d1e1"
    },
    {
      "number": 18,
      "text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "sha256": "7ef5610d928bfb456d7b55c1ea758bb4511f7cda6706aad4c1bcf2cd7829a2cb"
    },
    {
      "number": 19,
      "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
      "sha256": "c62f3c864ffeed97ef04131e31974cf13d488b213183fa8a5f547a9a24540bc3"
    },
    {
      "number": 20,
      "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
      "sha256": "4c0054dcee00d4164af204de84588365f795356d5d8d99355d9f9788eebafb59"
    },
    {
      "number": 21,
      "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
      "sha256": "971d6d59089c217b57da99ffde8973f94a830c8801ffcc7005ee57e5a8766b0b"
    },
    {
      "number": 22,
      "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
      "sha256": "d8716dade078709727beeb9f2a9e06badb33e91212a046dd7f5ae1b9f26ae05e"
    },
    {
      "number": 23,
      "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
      "sha256": "b59b790b3beaecdf2131f0d81a727ae6e943ae3595486e933951ac0ead8ad9a8"
    },
    {
      "number": 24,
      "text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
      "sha256": "4f41e6d888a416585a16610972c4ef6400f5e8db79a78cb15e76a5ff12fbd793"
    },
    {
      "number": 25,
      "text": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
      "sha256": "e8e333a8a9e1d4c9d03ffd793ffbd16bb2b3f8120e30f59dbbb60401346dcb4b"
    },
    {
      "number": 26,
      "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
      "sha256": "5b08fc34cf45df521b528ebb20af17129f55aaac5b22c7344c6702ad9036ba7f"
    },
    {
      "number": 27,
      "text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
      "sha256": "9081b8e68e718ea65b47549325e70563c14ca4deb3dd0cd78e772003fca55a26"
    },
    {
      "number": 28,
      "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
      "sha256": "e10146009eb29713d026638c3911e3aa65325de01028261d1aae8162a4c4880c"
    },
    {
      "number": 29,
      "text": "فَٱدْخُلِى فِى عِبَٰدِى",
      "sha256": "8525d63e877e7824de17b2c9d352e8e2de870485bbf169f0dd43fbefe6329664"
    },
    {
      "number": 30,
      "text": "وَٱدْخُلِى جَنَّتِى",
      "sha256": "8d1db6dd0f98f4c9b9b3a0a0e6f8588143cf773411b5e734e6f801b4155fb6b7"
    }
  ],
