  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "sha256": "636395fca8635c642b693fc1da03402fff2aa51ad6eaa25fcdf800aaf0ed13db"
    },
    {
      "number": 2,
      "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "sha256": "50e19ff65df9e7fd06e73fcd7f66d7ae7b6ce39e9589a405cb25156cd367523f"
    },
    {
      "number": 3,
      "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "sha256": "12f5899ea9199da98f4952e546160cc616bcaff8801545c81823c0aed6095d56"
    },
    {
      "number": 4,
      "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "sha256": "75c9f2221dd567a1f5317d2629359fe8493d40e6d3bb44ee23de9fdc99edc003"
    },
    {
      "number": 5,
      "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "sha256": "9b62655d34a3818e5044cbc005d03ed0367a362fe5a08e45bd2a93664acc5a47"
    },
    {
      "number": 6,
      "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "sha256": "dd518047eb39db3c90c2b6a5ee41a7d35cbf5c9147516d750155a3c8b8ec4af7"
    },
    {
      "number": 7,
      "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "sha256": "353dda954ad7838c7ca115f84896d2cb02025faf1a3b22e213be9442771d99db"
    },
    {
      "number": 8,
      "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "sha256": "c28b7e50410c53fd6884c7e88949f1e30b717c4a487e7411b493ce5d9be09bfc"
    },
    {
      "number": 9,
      "text": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "sha256": "adf1a2c08c48febe265c76e313857249c5c25727a5c54eeea2c8a65fc3ba0b27"
    },
    {
      "number": 10,
      "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "sha256": "545ccce2dc816237aa60ca4c77fde74acc1f99b5db1fbd6e65771ae6c6705f6f"
    },
    {
      "number": 11,
      "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "sha256": "e8b4646f41b33be1190c6cc1c6a65b9371b5a0ed9bbeafc0eff02c57748475da"
    },
    {
      "number": 12,
      "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "sha256": "5a8443e6a82b396c63b43655d41e9f77461cd00fa2a34f38fe4d745fe0af2337"
    },
    {
      "number": 13,
      "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "sha256": "aa6da993e82e3e7b06586dc7a3eccbeca774e1b67753beb8b82cdd245ceb5435"
    },
    {
      "number": 14,
      "text": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "sha256": "92a259111bb8e2e0d310389a36b41bc1f0cbf96aa08cd35accc1e615b33363a3"
    },
    {
      "number": 15,
      "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "sha256": "0a1a01b8777ecd61c325fd7de6b54a342fb7da895e9c1c54e5fa4850f1ae484e"
    },
    {
      "number": 16,
      "text": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "sha256": "b70a761e681af5c77d6ac7f886e0778faee57c0db659b779383be1f0ee719321"
    },
    {
      "number": 17,
      "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "sha256": "bd1a23a33a648883eb61708fdb9c06d6c63a5f23f5ddb1aedfa497c9b86abebd"
    },
    {
      "number": 18,
      "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "sha256": "e122b6b09857c545da99f19347b7ec679b0c56629876769d91361a14d2b34225"
    },
    {
      "number": 19,
      "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "sha256": "79a96a3c29638818efea7b2c0603c27017c50d6d321bbb10df654e32ab95b50a"
    },
    {
      "number": 20,
      "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "sha256": "de1126bd36f097a76a68d8fc605dc20c6817e1abd8d884fa93c6d7205cd160ef"
    },
    {
      "number": 21,
      "text": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "sha256": "32ec38c218ec11c15533cbb7876c99fa4f120c702ca74d62fbbd2e0cfd19fca3"
    },
    {
      "number": 22,
      "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "sha256": "4ba99f42f9515b90d83200b99aae749b83b78ef7c7d4fa2f1c7c3c5c9ae608b7"
    },
    {
      "number": 23,
      "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "sha256": "dbd02ce769e143d9e82157fa825b922363e480ede19e13672f64e24615ae8145"
    },
    {
      "number": 24,
      "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "sha256": "4fed1a89b8c8dfb65f204d1e2f490fe1cfc3dc483d7d8f3229691de3faed93ca"
    },
    {
      "number": 25,
      "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ",
      "sha256": "646f61c00b1790635352826be57c0fe59a403b76c70bcb3cd85dbab99eb6b371"
    },
    {
      "number": 26,
      "text": "فَأَيْنَ تَذْهَبُونَ",
      "sha256": "cbbc4e9f32515040a4c502ac0ebd8270b3ebafdf8a05ae36fd7eeb6be1e04d8a"
    },
    {
      "number": 27,
      "text": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ",
      "sha256": "b5e45234bbf85e0359413d93aa589b3293f9876a16127477fc50955a5dfff702"
    },
    {
      "number": 28,
      "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "sha256": "a65c2ec44e20affdeb06797f3e04134f2d2b9a1f4691fc44e25056879cc9d9ce"
    },
    {
      "number": 29,
      "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
      "sha256": "de1b9d99c84963f4d9cd7229847f5a04bd29984b036e927d6568102d7caa95fb"
    }
  ],
